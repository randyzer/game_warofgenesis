# Adsterra ad unit (public build-time values; not secrets)
# 32-character hex key from the Adsterra dashboard. Ads stay off when unset.
PUBLIC_ADSTERRA_KEY=
# Optional delivery-domain override. Defaults to pl31468463.profitableratecpmnetwork.com.
PUBLIC_ADSTERRA_DOMAIN=
# Optional GA4 Measurement ID override. Defaults to the project value in src/config/analytics.ts.
PUBLIC_GA_MEASUREMENT_ID=
