---
import { enabledPageCatalog, siteConfig } from "../core/site-data";

const year = new Date().getUTCFullYear();
const pageById = new Map(enabledPageCatalog.map((page) => [page.pageId, page]));
const footerGroups = [
  {
    label: "Start",
    pageIds: [
      "guide.beginner-guide",
      "guide.farming",
      "guide.gear",
      "hub.builds",
    ],
  },
  {
    label: "Market & tools",
    pageIds: [
      "hub.market",
      "market.best-items-to-sell",
      "tool.steam-market-fee-calculator",
    ],
  },
  { label: "Site", pageIds: ["hub.guides", "hub.tools", "search", "about"] },
  { label: "Legal", pageIds: ["privacy", "terms"] },
].map((group) => ({
  ...group,
  pages: group.pageIds.flatMap((pageId) => {
    const page = pageById.get(pageId);
    return page ? [page] : [];
  }),
}));
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <span class="eyebrow">{siteConfig.brand.shortName}</span>
      <p class="site-footer__statement">
        {siteConfig.brand.tagline}
      </p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      {footerGroups.map((group) => (
        <section>
          <strong>{group.label}</strong>
          {group.pages.map((page) => <a href={page.route}>{page.title}</a>)}
        </section>
      ))}
    </nav>
    <div class="site-footer__meta">
      <p>{siteConfig.brand.name} / {year}</p>
      <p>{siteConfig.brand.tagline}</p>
      <a href="/#top">Back to top ↑</a>
    </div>
  </div>
</footer>
