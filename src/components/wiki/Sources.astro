---
import type { Provenance } from "../../data/schemas/provenance";

interface Props {
  sources: Provenance[];
}

const { sources } = Astro.props;
const lastVerified = [...sources]
  .sort((left, right) => right.accessedAt.localeCompare(left.accessedAt))
  .at(0)?.accessedAt;
---

{sources.length > 0 && (
  <section class="sources evidence section-rule" aria-labelledby="sources-title">
    <div>
      <p class="eyebrow">Sources & verification</p>
      <h2 id="sources-title">How this page was checked</h2>
      {lastVerified && (
        <p class="sources__verified">
          Last verified <time datetime={lastVerified}>{lastVerified}</time>
        </p>
      )}
    </div>
    <ol>
      {sources.map((source, index) => (
        <li>
          <span>{(index + 1).toString().padStart(2, "0")}</span>
          <div>
            <strong>{new URL(source.sourceUrl).hostname.replace(/^www\./, "")}</strong>
            <small>{source.sourceType.replaceAll("-", " ")}</small>
            <p>{source.evidenceNote}</p>
            <a href={source.sourceUrl} rel="noreferrer">
              View source <span aria-hidden="true">↗</span>
            </a>
          </div>
          <time datetime={source.accessedAt}>Checked {source.accessedAt}</time>
        </li>
      ))}
    </ol>
  </section>
)}
