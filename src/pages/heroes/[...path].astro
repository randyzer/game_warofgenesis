---
import EntityDatabase from "../../components/EntityDatabase.astro";
import type { EntityDatabaseRow } from "../../core/filter-state";
import EntityDetail from "../../components/EntityDetail.astro";
import { buildEntityModuleRouteRecords, type EntityModuleRouteRecord } from "../../core/entity-route-model";
import { loadFactModule } from "../../core/fact-loader";
import { enabledPageCatalog, siteConfig } from "../../core/site-data";
import { getEntityModuleDefinition } from "../../data/entity-modules";
import type { HeroFact } from "../../data/schemas/facts";

interface Props {
  record: EntityModuleRouteRecord<HeroFact>;
}

const moduleDefinition = getEntityModuleDefinition("heroes");

export function getStaticPaths() {
  const definition = getEntityModuleDefinition("heroes");
  if (!siteConfig.features[definition.module]) return [];

  const facts = loadFactModule(definition.module, siteConfig);
  return buildEntityModuleRouteRecords({
    segment: definition.routeSegment,
    module: definition.module,
    entityType: definition.entityType,
    catalog: enabledPageCatalog,
    facts,
  }).map((record) => ({ params: { path: record.path }, props: { record } }));
}

const { record } = Astro.props;
const detailRoutes = new Map(
  enabledPageCatalog.flatMap((page) =>
    page.entityRef?.entityType === moduleDefinition.entityType
      ? [[page.entityRef.entityId, page.route] as const]
      : [],
  ),
);
const rows: EntityDatabaseRow[] = record.facts.map((fact) => ({
  id: fact.id,
  name: fact.name,
  summary: fact.summary,
  classification: fact.role,
  detail: `Difficulty ${fact.difficulty}/5`,
  patch: fact.patch,
  route: detailRoutes.get(fact.id),
}));
---

{record.view === "detail" ? (
  <EntityDetail
    page={record.page}
    fact={record.fact}
    entityLabel={moduleDefinition.singularLabel}
    fields={[
      { label: "Role", value: record.fact.role },
      { label: "Difficulty", value: `${record.fact.difficulty}/5` },
      { label: "Strengths", value: record.fact.strengths.join(" · ") },
      { label: "Weaknesses", value: record.fact.weaknesses.join(" · ") },
    ]}
  />
) : (
  <EntityDatabase page={record.page} rows={rows} entityLabel={moduleDefinition.pluralLabel} view={record.view} />
)}
