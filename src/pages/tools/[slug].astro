---
import ToolShell from "../../components/ToolShell.astro";
import SteamMarketFeeTool from "../../components/SteamMarketFeeTool.astro";
import { buildToolRouteRecords, selectToolPages } from "../../core/page-models";
import { enabledPageCatalog } from "../../core/site-data";
import { loadToolDefinition } from "../../core/tool-loader";
import type { ToolRouteRecord } from "../../core/page-models";
import type { ToolDefinition } from "../../data/schemas/tools";

interface Props {
  record: ToolRouteRecord;
  definition?: ToolDefinition;
}

export function getStaticPaths() {
  return buildToolRouteRecords(selectToolPages(enabledPageCatalog)).map(
    (record) => ({
      params: { slug: record.slug },
      props: {
        record,
        definition:
          record.slug === "steam-market-fee-calculator"
            ? undefined
            : loadToolDefinition(record.slug, record.kind),
      },
    }),
  );
}

const { record, definition } = Astro.props;
---

{record.slug === "steam-market-fee-calculator" ? (
  <SteamMarketFeeTool page={record.page} />
) : definition ? (
  <ToolShell page={record.page} definition={definition} />
) : null}
