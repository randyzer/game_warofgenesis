---
import SearchIsland from "../../components/islands/SearchIsland";
import {
  buildSearchRouteRecords,
  type SearchRouteRecord,
} from "../../core/optional-routes";
import { enabledPageCatalog } from "../../core/site-data";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  record: SearchRouteRecord;
}

export function getStaticPaths() {
  return buildSearchRouteRecords(enabledPageCatalog).map((record) => ({
    params: { path: record.path },
    props: { record },
  }));
}

const { record } = Astro.props;
const { page, fallbackPage } = record;
---

<BaseLayout page={page}>
  <main id="main-content" class="search-shell shell">
    <header class="search-shell__header reveal reveal--1">
      <p class="eyebrow">Local index / no external query log</p>
      <h1>{page.title}</h1>
      <p>{page.description}</p>
    </header>

    <SearchIsland client:load />

    {fallbackPage && (
      <a class="text-link" href={fallbackPage.route}>
        Browse every guide instead <span aria-hidden="true">→</span>
      </a>
    )}
  </main>
</BaseLayout>
